{
  "name": "drag-import-relative-path",
  "displayName": "%displayName%",
  "description": "%description%",
  "publisher": "ElecTreeFrying",
  "version": "1.0.2",
  "author": {
    "name": "John James Ermitaño",
    "email": "jjgermitano@gmail.com"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.97.0"
  },
  "homepage": "https://github.com/ElecTreeFrying/drag-import-relative-path",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElecTreeFrying/drag-import-relative-path.git"
  },
  "bugs": {
    "email": "electreefrying.git@gmail.com",
    "url": "https://github.com/ElecTreeFrying/drag-import-relative-path/issues"
  },
  "qna": "https://github.com/ElecTreeFrying/drag-import-relative-path/issues",
  "pricing": "Free",
  "sponsor": {
    "url": "https://github.com/ElecTreeFrying/drag-import-relative-path#support"
  },
  "badges": [
    {
      "url": "https://vsmarketplacebadges.dev/version-short/ElecTreeFrying.drag-import-relative-path.png",
      "description": "Version badge",
      "href": "https://marketplace.visualstudio.com/items?itemName=ElecTreeFrying.drag-import-relative-path"
    },
    {
      "url": "https://vsmarketplacebadges.dev/downloads-short/ElecTreeFrying.drag-import-relative-path.png",
      "description": "Downloads badge",
      "href": "https://marketplace.visualstudio.com/items?itemName=ElecTreeFrying.drag-import-relative-path"
    },
    {
      "url": "https://vsmarketplacebadges.dev/installs-short/ElecTreeFrying.drag-import-relative-path.png",
      "description": "Installs badge",
      "href": "https://marketplace.visualstudio.com/items?itemName=ElecTreeFrying.drag-import-relative-path"
    },
    {
      "url": "https://vsmarketplacebadges.dev/rating-short/ElecTreeFrying.drag-import-relative-path.png",
      "description": "Rating badge",
      "href": "https://marketplace.visualstudio.com/items?itemName=ElecTreeFrying.drag-import-relative-path"
    }
  ],
  "galleryBanner": {
    "color": "#8C1D0F",
    "theme": "dark"
  },
  "license": "MIT",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "drag and drop",
    "drag import",
    "drag and drop import",
    "relative import",
    "relative path",
    "auto import",
    "react",
    "nextjs",
    "vue",
    "angular",
    "svelte",
    "astro",
    "nuxt",
    "sveltekit",
    "remix",
    "typescript",
    "javascript",
    "jsx",
    "tsx",
    "sass",
    "scss",
    "css modules",
    "mdx",
    "markdown",
    "latex",
    "nodejs",
    "deno",
    "bun",
    "vite",
    "monorepo"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:html",
    "onLanguage:markdown",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro",
    "onLanguage:mdx",
    "onLanguage:latex",
    "workspaceContains:**/*.mdx",
    "workspaceContains:**/*.tex"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "drag-import.setDefaultImportStyle",
        "title": "%command.setDefaultImportStyle.title%"
      },
      {
        "command": "drag-import.setImportPlacement",
        "title": "%command.setImportPlacement.title%"
      },
      {
        "command": "drag-import.togglePreserveScriptExtension",
        "title": "%command.togglePreserveScriptExtension.title%"
      },
      {
        "command": "drag-import.resetImportStyles",
        "title": "%command.resetImportStyles.title%"
      }
    ],
    "configuration": [
      {
        "title": "%configuration.title%",
        "properties": {
          "drag-import.preferences.importStatementPlacement": {
            "title": "%config.preferences.importStatementPlacement.title%",
            "description": "%config.preferences.importStatementPlacement.description%",
            "type": "string",
            "default": "Bottom",
            "enum": [
              "Top",
              "Bottom",
              "Cursor"
            ],
            "enumDescriptions": [
              "%config.preferences.importStatementPlacement.enumDescriptions.0%",
              "%config.preferences.importStatementPlacement.enumDescriptions.1%",
              "%config.preferences.importStatementPlacement.enumDescriptions.2%"
            ]
          },
          "drag-import.preferences.requestReview": {
            "title": "%config.preferences.requestReview.title%",
            "description": "%config.preferences.requestReview.description%",
            "type": "boolean",
            "default": true
          },
          "drag-import.importStatement.script.preserveScriptFileExtension": {
            "title": "%config.importStatement.script.preserveScriptFileExtension.title%",
            "description": "%config.importStatement.script.preserveScriptFileExtension.description%",
            "type": "boolean",
            "default": false
          },
          "drag-import.importStatement.script.javascriptImportStyle": {
            "title": "%config.importStatement.script.javascriptImportStyle.title%",
            "description": "%config.importStatement.script.javascriptImportStyle.description%",
            "type": "string",
            "default": "import name from '_relativePath_';",
            "enum": [
              "import name from '_relativePath_';",
              "import { name } from '_relativePath_';",
              "import name, { other } from '_relativePath_';",
              "import * as name from '_relativePath_';",
              "import '_relativePath_';",
              "const name = require('_relativePath_');",
              "const name = await import('_relativePath_');"
            ],
            "enumDescriptions": [
              "%config.importStatement.script.javascriptImportStyle.enumDescriptions.0%",
              "%config.importStatement.script.javascriptImportStyle.enumDescriptions.1%",
              "%config.importStatement.script.javascriptImportStyle.enumDescriptions.2%",
              "%config.importStatement.script.javascriptImportStyle.enumDescriptions.3%",
              "%config.importStatement.script.javascriptImportStyle.enumDescriptions.4%",
              "%config.importStatement.script.javascriptImportStyle.enumDescriptions.5%",
              "%config.importStatement.script.javascriptImportStyle.enumDescriptions.6%"
            ]
          },
          "drag-import.importStatement.script.typescriptImportStyle": {
            "title": "%config.importStatement.script.typescriptImportStyle.title%",
            "description": "%config.importStatement.script.typescriptImportStyle.description%",
            "type": "string",
            "default": "import { name } from '_relativePath_';",
            "enum": [
              "import { name } from '_relativePath_';",
              "import name from '_relativePath_';",
              "import * as name from '_relativePath_';",
              "import '_relativePath_';",
              "import type { name } from '_relativePath_';",
              "import { name, type Type } from '_relativePath_';",
              "const name = await import('_relativePath_');"
            ],
            "enumDescriptions": [
              "%config.importStatement.script.typescriptImportStyle.enumDescriptions.0%",
              "%config.importStatement.script.typescriptImportStyle.enumDescriptions.1%",
              "%config.importStatement.script.typescriptImportStyle.enumDescriptions.2%",
              "%config.importStatement.script.typescriptImportStyle.enumDescriptions.3%",
              "%config.importStatement.script.typescriptImportStyle.enumDescriptions.4%",
              "%config.importStatement.script.typescriptImportStyle.enumDescriptions.5%",
              "%config.importStatement.script.typescriptImportStyle.enumDescriptions.6%"
            ]
          },
          "drag-import.importStatement.styleSheet.preserveStylesheetFileExtension": {
            "title": "%config.importStatement.styleSheet.preserveStylesheetFileExtension.title%",
            "description": "%config.importStatement.styleSheet.preserveStylesheetFileExtension.description%",
            "type": "boolean",
            "default": false
          },
          "drag-import.importStatement.styleSheet.cssImportStyle": {
            "title": "%config.importStatement.styleSheet.cssImportStyle.title%",
            "description": "%config.importStatement.styleSheet.cssImportStyle.description%",
            "type": "string",
            "default": "@import '_relativePath_';",
            "enum": [
              "@import '_relativePath_';",
              "@import url('_relativePath_');"
            ],
            "enumDescriptions": [
              "%config.importStatement.styleSheet.cssImportStyle.enumDescriptions.0%",
              "%config.importStatement.styleSheet.cssImportStyle.enumDescriptions.1%"
            ]
          },
          "drag-import.importStatement.styleSheet.cssImageImportStyle": {
            "title": "%config.importStatement.styleSheet.cssImageImportStyle.title%",
            "description": "%config.importStatement.styleSheet.cssImageImportStyle.description%",
            "type": "string",
            "default": "url('_relativePath_')",
            "enum": [
              "url('_relativePath_')"
            ],
            "enumDescriptions": [
              "%config.importStatement.styleSheet.cssImageImportStyle.enumDescriptions.0%"
            ]
          },
          "drag-import.importStatement.styleSheet.scssImportStyle": {
            "title": "%config.importStatement.styleSheet.scssImportStyle.title%",
            "description": "%config.importStatement.styleSheet.scssImportStyle.description%",
            "type": "string",
            "default": "@use '_relativePath_';",
            "enum": [
              "@use '_relativePath_';",
              "@use '_relativePath_' as *;",
              "@use '_relativePath_' as name;",
              "@forward '_relativePath_';",
              "@import '_relativePath_';"
            ],
            "enumDescriptions": [
              "%config.importStatement.styleSheet.scssImportStyle.enumDescriptions.0%",
              "%config.importStatement.styleSheet.scssImportStyle.enumDescriptions.1%",
              "%config.importStatement.styleSheet.scssImportStyle.enumDescriptions.2%",
              "%config.importStatement.styleSheet.scssImportStyle.enumDescriptions.3%",
              "%config.importStatement.styleSheet.scssImportStyle.enumDescriptions.4%"
            ]
          },
          "drag-import.importStatement.styleSheet.scssImageImportStyle": {
            "title": "%config.importStatement.styleSheet.scssImageImportStyle.title%",
            "description": "%config.importStatement.styleSheet.scssImageImportStyle.description%",
            "type": "string",
            "default": "url('_relativePath_')",
            "enum": [
              "url('_relativePath_')"
            ],
            "enumDescriptions": [
              "%config.importStatement.styleSheet.scssImageImportStyle.enumDescriptions.0%"
            ]
          },
          "drag-import.importStatement.markup.htmlScriptImportStyle": {
            "title": "%config.importStatement.markup.htmlScriptImportStyle.title%",
            "description": "%config.importStatement.markup.htmlScriptImportStyle.description%",
            "type": "string",
            "default": "<script src=\"_relativePath_\"></script>",
            "enum": [
              "<script src=\"_relativePath_\"></script>",
              "<script src=\"_relativePath_\" defer></script>",
              "<script type=\"module\" src=\"_relativePath_\"></script>",
              "<script src=\"_relativePath_\" async></script>",
              "<script type=\"text/javascript\" src=\"_relativePath_\"></script>"
            ],
            "enumDescriptions": [
              "%config.importStatement.markup.htmlScriptImportStyle.enumDescriptions.0%",
              "%config.importStatement.markup.htmlScriptImportStyle.enumDescriptions.1%",
              "%config.importStatement.markup.htmlScriptImportStyle.enumDescriptions.2%",
              "%config.importStatement.markup.htmlScriptImportStyle.enumDescriptions.3%",
              "%config.importStatement.markup.htmlScriptImportStyle.enumDescriptions.4%"
            ]
          },
          "drag-import.importStatement.markup.htmlImageImportStyle": {
            "title": "%config.importStatement.markup.htmlImageImportStyle.title%",
            "description": "%config.importStatement.markup.htmlImageImportStyle.description%",
            "type": "string",
            "default": "<img src=\"_relativePath_\" alt=\"sample\">",
            "enum": [
              "<img src=\"_relativePath_\" alt=\"sample\">",
              "<img src=\"_relativePath_\" alt=\"\" loading=\"lazy\">",
              "<img src=\"_relativePath_\" alt=\"\" width=\"\" height=\"\">"
            ],
            "enumDescriptions": [
              "%config.importStatement.markup.htmlImageImportStyle.enumDescriptions.0%",
              "%config.importStatement.markup.htmlImageImportStyle.enumDescriptions.1%",
              "%config.importStatement.markup.htmlImageImportStyle.enumDescriptions.2%"
            ]
          },
          "drag-import.importStatement.markup.htmlVideoImportStyle": {
            "title": "%config.importStatement.markup.htmlVideoImportStyle.title%",
            "description": "%config.importStatement.markup.htmlVideoImportStyle.description%",
            "type": "string",
            "default": "<video src=\"_relativePath_\" controls></video>",
            "enum": [
              "<video src=\"_relativePath_\" controls></video>",
              "<video src=\"_relativePath_\" autoplay muted loop playsinline></video>",
              "<video src=\"_relativePath_\" controls poster=\"\"></video>",
              "<video src=\"_relativePath_\" controls preload=\"metadata\"></video>"
            ],
            "enumDescriptions": [
              "%config.importStatement.markup.htmlVideoImportStyle.enumDescriptions.0%",
              "%config.importStatement.markup.htmlVideoImportStyle.enumDescriptions.1%",
              "%config.importStatement.markup.htmlVideoImportStyle.enumDescriptions.2%",
              "%config.importStatement.markup.htmlVideoImportStyle.enumDescriptions.3%"
            ]
          },
          "drag-import.importStatement.markup.htmlAudioImportStyle": {
            "title": "%config.importStatement.markup.htmlAudioImportStyle.title%",
            "description": "%config.importStatement.markup.htmlAudioImportStyle.description%",
            "type": "string",
            "default": "<audio src=\"_relativePath_\" controls></audio>",
            "enum": [
              "<audio src=\"_relativePath_\" controls></audio>",
              "<audio src=\"_relativePath_\" controls preload=\"metadata\"></audio>"
            ],
            "enumDescriptions": [
              "%config.importStatement.markup.htmlAudioImportStyle.enumDescriptions.0%",
              "%config.importStatement.markup.htmlAudioImportStyle.enumDescriptions.1%"
            ]
          },
          "drag-import.importStatement.markup.htmlStyleSheetImportStyle": {
            "title": "%config.importStatement.markup.htmlStyleSheetImportStyle.title%",
            "description": "%config.importStatement.markup.htmlStyleSheetImportStyle.description%",
            "type": "string",
            "default": "<link href=\"_relativePath_\" rel=\"stylesheet\">",
            "enum": [
              "<link href=\"_relativePath_\" rel=\"stylesheet\">"
            ],
            "enumDescriptions": [
              "%config.importStatement.markup.htmlStyleSheetImportStyle.enumDescriptions.0%"
            ]
          },
          "drag-import.importStatement.markup.markdownImportStyle": {
            "title": "%config.importStatement.markup.markdownImportStyle.title%",
            "description": "%config.importStatement.markup.markdownImportStyle.description%",
            "type": "string",
            "default": "[text](_relativePath_)",
            "enum": [
              "[text](_relativePath_)"
            ],
            "enumDescriptions": [
              "%config.importStatement.markup.markdownImportStyle.enumDescriptions.0%"
            ]
          },
          "drag-import.importStatement.markup.markdownImageImportStyle": {
            "title": "%config.importStatement.markup.markdownImageImportStyle.title%",
            "description": "%config.importStatement.markup.markdownImageImportStyle.description%",
            "type": "string",
            "default": "![alt-text](_relativePath_)",
            "enum": [
              "![alt-text](_relativePath_)",
              "![alt-text](_relativePath_ \"Hover text\")",
              "<img src=\"_relativePath_\" alt=\"\" width=\"\" height=\"\">"
            ],
            "enumDescriptions": [
              "%config.importStatement.markup.markdownImageImportStyle.enumDescriptions.0%",
              "%config.importStatement.markup.markdownImageImportStyle.enumDescriptions.1%",
              "%config.importStatement.markup.markdownImageImportStyle.enumDescriptions.2%"
            ]
          },
          "drag-import.importStatement.latex.preserveGraphicsFileExtension": {
            "title": "%config.importStatement.latex.preserveGraphicsFileExtension.title%",
            "description": "%config.importStatement.latex.preserveGraphicsFileExtension.description%",
            "type": "boolean",
            "default": true
          },
          "drag-import.importStatement.latex.graphicsImportStyle": {
            "title": "%config.importStatement.latex.graphicsImportStyle.title%",
            "description": "%config.importStatement.latex.graphicsImportStyle.description%",
            "type": "string",
            "default": "\\begin{figure}[htbp] \\centering \\includegraphics[width=0.5\\textwidth]{_relativePath_} \\caption{} \\label{fig:} \\end{figure}",
            "enum": [
              "\\begin{figure}[htbp] \\centering \\includegraphics[width=0.5\\textwidth]{_relativePath_} \\caption{} \\label{fig:} \\end{figure}",
              "\\includegraphics[width=0.5\\textwidth]{_relativePath_}",
              "\\includegraphics{_relativePath_}"
            ],
            "enumDescriptions": [
              "%config.importStatement.latex.graphicsImportStyle.enumDescriptions.0%",
              "%config.importStatement.latex.graphicsImportStyle.enumDescriptions.1%",
              "%config.importStatement.latex.graphicsImportStyle.enumDescriptions.2%"
            ]
          },
          "drag-import.importStatement.latex.inputImportStyle": {
            "title": "%config.importStatement.latex.inputImportStyle.title%",
            "description": "%config.importStatement.latex.inputImportStyle.description%",
            "type": "string",
            "default": "\\input{_relativePath_}",
            "enum": [
              "\\input{_relativePath_}",
              "\\include{_relativePath_}"
            ],
            "enumDescriptions": [
              "%config.importStatement.latex.inputImportStyle.enumDescriptions.0%",
              "%config.importStatement.latex.inputImportStyle.enumDescriptions.1%"
            ]
          },
          "drag-import.importStatement.latex.bibliographyImportStyle": {
            "title": "%config.importStatement.latex.bibliographyImportStyle.title%",
            "description": "%config.importStatement.latex.bibliographyImportStyle.description%",
            "type": "string",
            "default": "\\addbibresource{_relativePath_}",
            "enum": [
              "\\addbibresource{_relativePath_}",
              "\\bibliography{_relativePath_}"
            ],
            "enumDescriptions": [
              "%config.importStatement.latex.bibliographyImportStyle.enumDescriptions.0%",
              "%config.importStatement.latex.bibliographyImportStyle.enumDescriptions.1%"
            ]
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "1.97.0",
    "@types/node": "^22.19.18",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
